# Реквизиты продавца. Скопируй в requisites.env, заполни и запусти ./fill.sh
#
# requisites.env в .gitignore — паспортных данных в публичном репозитории быть
# не должно. В HTML попадут только те значения, которые Robokassa и закон
# требуют показывать покупателю: ФИО, ИНН, почта, город.
#
# Телефона на сайте нет намеренно. Если модерация Robokassa его затребует,
# заведи виртуальный номер и добавь строку PHONE сюда и в contacts.html —
# личный номер в публичном репозитории лучше не держать.

FULL_NAME="Гришутин Михаил Сергеевич"   # полностью, как в «Мой налог»
SELLER_SHORT="Гришутин М. С."           # для подвала сайта
INN="770000000000"                      # 12 цифр
ADDRESS="г. Москва"                     # достаточно города; точный адрес публиковать не обязательно
EMAIL="support@mewmori.com"
DATE="4 августа 2026 г."                # дата редакции документов
